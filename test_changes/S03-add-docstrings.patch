@@ -25,21 +29,25 @@ class NoteStore:
         self._next_id = 1
 
     def add(self, note: NoteIn) -> Note:
+        """Save a note under the next free id."""
         saved = Note(id=self._next_id, **note.model_dump())
         self._notes[saved.id] = saved
         self._next_id += 1
         return saved
 
     def all(self) -> list[Note]:
+        """Every note, oldest first."""
         return list(self._notes.values())
 
     def get(self, note_id: int) -> Note | None:
         return self._notes.get(note_id)
 
     def remove(self, note_id: int) -> bool:
+        """Delete a note. Returns False if there was nothing to delete."""
         return self._notes.pop(note_id, None) is not None
 
     def clear(self) -> None:
+        """Drop every note and start ids at 1 again. The tests call this."""
         self._notes.clear()
         self._next_id = 1
 
