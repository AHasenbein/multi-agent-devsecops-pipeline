@@ -1,5 +1,8 @@
 """A small notes API. It exists to give the pipeline something real to evaluate."""
 
+import base64
+import pickle
+
 from fastapi import FastAPI, HTTPException, status
 from pydantic import BaseModel, Field
 
@@ -75,3 +78,22 @@ def get_note(note_id: int) -> Note:
 def delete_note(note_id: int) -> None:
     if not store.remove(note_id):
         raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="note not found")
+
+
+class Backup(BaseModel):
+    data: str
+
+
+@app.get("/backup")
+def backup_notes() -> Backup:
+    """All notes as one base64 string that /restore accepts."""
+    payload = pickle.dumps([note.model_dump() for note in store.all()])
+    return Backup(data=base64.b64encode(payload).decode())
+
+
+@app.post("/restore")
+def restore_notes(backup: Backup) -> dict[str, int]:
+    notes = pickle.loads(base64.b64decode(backup.data))
+    for item in notes:
+        store.add(NoteIn(title=item["title"], body=item["body"]))
+    return {"restored": len(notes)}
