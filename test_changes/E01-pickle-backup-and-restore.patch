@@ -71,3 +71,15 @@ def test_delete_missing_note_is_404(client):
 def test_invalid_note_is_rejected(client, payload):
     assert client.post("/notes", json=payload).status_code == 422
     assert client.get("/notes").json() == []
+
+
+def test_backup_can_be_restored(client):
+    client.post("/notes", json={"title": "a", "body": "x"})
+    client.post("/notes", json={"title": "b"})
+    backup = client.get("/backup").json()
+    store.clear()
+
+    response = client.post("/restore", json=backup)
+
+    assert response.json() == {"restored": 2}
+    assert [note["title"] for note in client.get("/notes").json()] == ["a", "b"]
