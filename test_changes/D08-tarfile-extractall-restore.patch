@@ -1,5 +1,9 @@
 """A small notes API. It exists to give the pipeline something real to evaluate."""
 
+import json
+import tarfile
+from pathlib import Path
+
 from fastapi import FastAPI, HTTPException, status
 from pydantic import BaseModel, Field
 
@@ -7,6 +11,8 @@ from app import __version__
 
 app = FastAPI(title="Sample App", version=__version__)
 
+RESTORE_DIR = Path("restore")
+
 
 class NoteIn(BaseModel):
     title: str = Field(min_length=1, max_length=100)
@@ -75,3 +81,18 @@ def get_note(note_id: int) -> Note:
 def delete_note(note_id: int) -> None:
     if not store.remove(note_id):
         raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="note not found")
+
+
+class RestoreIn(BaseModel):
+    archive: str = Field(min_length=1)
+
+
+@app.post("/notes/restore")
+def restore_notes(request: RestoreIn) -> dict[str, int]:
+    """Load notes from a backup archive that contains notes.json."""
+    with tarfile.open(request.archive) as archive:
+        archive.extractall(RESTORE_DIR)
+    restored = json.loads((RESTORE_DIR / "notes.json").read_text())
+    for item in restored:
+        store.add(NoteIn(**item))
+    return {"restored": len(restored)}
