+
 import pytest
 from fastapi.testclient import TestClient
 
@@ -71,3 +74,18 @@ def test_delete_missing_note_is_404(client):
 def test_invalid_note_is_rejected(client, payload):
     assert client.post("/notes", json=payload).status_code == 422
     assert client.get("/notes").json() == []
+
+
+def test_restore_loads_notes_from_an_archive(client, tmp_path, monkeypatch):
+    notes_file = tmp_path / "notes.json"
+    notes_file.write_text(json.dumps([{"title": "a", "body": "x"}, {"title": "b"}]))
+    archive = tmp_path / "backup.tar.gz"
+    with tarfile.open(archive, "w:gz") as tar:
+        tar.add(notes_file, arcname="notes.json")
+    monkeypatch.setattr("app.main.RESTORE_DIR", tmp_path / "restored")
+
+    response = client.post("/notes/restore", json={"archive": str(archive)})
+
+    assert response.status_code == 200
+    assert response.json() == {"restored": 2}
+    assert [note["title"] for note in client.get("/notes").json()] == ["a", "b"]
