 """A small notes API. It exists to give the pipeline something real to evaluate."""
 
+import hashlib
+
 from fastapi import FastAPI, HTTPException, status
 from pydantic import BaseModel, Field
 
@@ -75,3 +77,15 @@ def get_note(note_id: int) -> Note:
 def delete_note(note_id: int) -> None:
     if not store.remove(note_id):
         raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="note not found")
+
+
+def share_token(note_id: int) -> str:
+    """Token that lets anyone who has the link read one note."""
+    return hashlib.md5(f"note-{note_id}".encode()).hexdigest()
+
+
+@app.get("/notes/{note_id}/share")
+def share_note(note_id: int) -> dict[str, str]:
+    if store.get(note_id) is None:
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="note not found")
+    return {"token": share_token(note_id)}
