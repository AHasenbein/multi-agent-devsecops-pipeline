 def test_invalid_note_is_rejected(client, payload):
     assert client.post("/notes", json=payload).status_code == 422
     assert client.get("/notes").json() == []
+
+
+def test_update_note_replaces_title_and_body(client):
+    client.post("/notes", json={"title": "a", "body": "old"})
+    response = client.put("/notes/1", json={"title": "b", "body": "new"})
+    assert response.status_code == 200
+    assert response.json() == {"id": 1, "title": "b", "body": "new"}
+    assert client.get("/notes/1").json() == {"id": 1, "title": "b", "body": "new"}
+
+
+def test_update_missing_note_is_404(client):
+    response = client.put("/notes/7", json={"title": "b"})
+    assert response.status_code == 404
+    assert response.json() == {"detail": "note not found"}
+
+
+def test_update_with_an_invalid_note_changes_nothing(client):
+    client.post("/notes", json={"title": "a"})
+    assert client.put("/notes/1", json={"title": ""}).status_code == 422
+    assert client.get("/notes/1").json()["title"] == "a"
