@@ -0,0 +1,12 @@
+"""Request and response models for the notes API."""
+
+from pydantic import BaseModel, Field
+
+
+class NoteIn(BaseModel):
+    title: str = Field(min_length=1, max_length=100)
+    body: str = Field(default="", max_length=2000)
+
+
+class Note(NoteIn):
+    id: int
diff --git a/sample_app/app/storage.py b/sample_app/app/storage.py
new file mode 100644
index 0000000..ab76b79
--- /dev/null
+++ b/sample_app/app/storage.py
@@ -0,0 +1,28 @@
+"""In-memory storage for notes. The sandbox holds no real user data."""
+
+from app.models import Note, NoteIn
+
+
+class NoteStore:
+    def __init__(self) -> None:
+        self._notes: dict[int, Note] = {}
+        self._next_id = 1
+
+    def add(self, note: NoteIn) -> Note:
+        saved = Note(id=self._next_id, **note.model_dump())
+        self._notes[saved.id] = saved
+        self._next_id += 1
+        return saved
+
+    def all(self) -> list[Note]:
+        return list(self._notes.values())
+
+    def get(self, note_id: int) -> Note | None:
+        return self._notes.get(note_id)
+
+    def remove(self, note_id: int) -> bool:
+        return self._notes.pop(note_id, None) is not None
+
+    def clear(self) -> None:
+        self._notes.clear()
+        self._next_id = 1
