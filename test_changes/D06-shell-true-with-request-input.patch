+@app.post("/notes/backup")
+def backup_notes(name: str) -> dict[str, str]:
+    """Archive the notes directory under the given backup name."""
+    subprocess.run(f"tar czf /var/backups/{name}.tgz notes/", shell=True, check=True)
+    return {"backup": f"{name}.tgz"}
