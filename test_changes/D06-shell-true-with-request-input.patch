+def test_backup_runs_tar_with_the_given_name(client, monkeypatch):
+    commands = []
+    monkeypatch.setattr("app.main.subprocess.run", lambda cmd, **kwargs: commands.append(cmd))
+    response = client.post("/notes/backup", params={"name": "nightly"})
+    assert response.status_code == 200
+    assert response.json() == {"backup": "nightly.tgz"}
+    assert commands == ["tar czf /var/backups/nightly.tgz notes/"]
